<RetryUntilSuccessful num_attempts="-1">
  <Fallback name="RunAndCleanup">
    <Sequence name="DockingSequence">
      <MoveForklift target_height="20.0" timeout_s="15.0" tolerance_mm="3.0"/>
      <RetryUntilSuccessful num_attempts="-1">
        <Fallback name="VisualServoingWithRecovery">
          <VisualServoingAction target_area="18000.0"/>
          <Sequence name="VSBackupRecovery">
            <DriveRawAction linear_x="-0.02" angular_z="0.0" duration_sec="8.0"/>
            <DriveRawAction linear_x="0.0"   angular_z="0.0" duration_sec="1.0"/>
            <AlwaysFailure/>
          </Sequence>
        </Fallback>
      </RetryUntilSuccessful>
      <MoveForklift target_height="58.0" timeout_s="15.0" tolerance_mm="3.0"/>
      <DriveRawAction linear_x="0.02"  angular_z="0.0" duration_sec="15.0"/>
      <DriveRawAction linear_x="0.0"   angular_z="0.0" duration_sec="3.0"/>
      <MoveForklift target_height="140.0" timeout_s="15.0" tolerance_mm="6.0"/>
      <DriveRawAction linear_x="-0.03" angular_z="0.0" duration_sec="8.0"/>
      <DriveRawAction linear_x="0.0"   angular_z="0.0" duration_sec="2.0"/>
      <DriveRawAction linear_x="0.0"   angular_z="0.08" duration_sec="6.0"/>
    </Sequence>
    <AlwaysSuccess/>
  </Fallback>
</RetryUntilSuccessful>
<GoToAction zone="{qr_data}"/>
<MoveForklift target_height="0.0" timeout_s="15.0" tolerance_mm="3.0"/>
<GoToAction zone="inspect"/>