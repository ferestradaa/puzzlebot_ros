  <root BTCPP_format="4">
    <BehaviorTree ID="PuzzlebotTree">
      <Sequence name="MainSequence">
        <CheckMapAvailable timeout_sec="10.0"/>
        <RetryUntilSuccessful num_attempts="-1">
          <IsLocalizedCondition/>
        </RetryUntilSuccessful>
        <KeepRunningUntilFailure>

          <Sequence name="PickPlaceCycle">

          <SetControllerSource source="pure_pursuit"/>
            <GoToAction zone="inspect"/>
            <SetBlackboard output_key="search_zone" value="inspect"/>

            <RetryUntilSuccessful num_attempts="-1">
              <Fallback name="SearchQR">

                <Sequence name="SearchInspect">
                <MoveForklift target_height="25.0" timeout_s="15.0" tolerance_mm="3.0"/>
                  <Parallel success_count="1" failure_count="1">
                    <Sequence>

                    <SetControllerSource source="drive_raw"/>
                      <DriveRawAction linear_x="0.0" angular_z="0.02" duration_sec="10.0"/>
                      <DriveRawAction linear_x="0.0" angular_z="-0.02" duration_sec="10.0"/>
                      <AlwaysFailure/>
                    </Sequence>
                    <Sequence>
                      <SetBlackboard output_key="search_zone" value="inspect"/>
                      <WaitForQRPoseAction timeout_sec="999" qr_pose="{qr_pose}" qr_data="{qr_data}"/>
                    </Sequence>
                  </Parallel>
                </Sequence>

                <Sequence name="SearchInspect2">
                <SetControllerSource source="pure_pursuit"/>
                  <GoToAction zone="inspect2"/>
                  <Parallel success_count="1" failure_count="1">
                    <Sequence>
                    <SetControllerSource source="drive_raw"/>
                      <DriveRawAction linear_x="0.0" angular_z="0.02" duration_sec="10.0"/>
                      <DriveRawAction linear_x="0.0" angular_z="-0.02" duration_sec="10.0"/>
                      <AlwaysFailure/>
                    </Sequence>
                    <Sequence>
                      <SetBlackboard output_key="search_zone" value="inspect2"/>
                      <WaitForQRPoseAction timeout_sec="999" qr_pose="{qr_pose}" qr_data="{qr_data}"/>
                    </Sequence>
                  </Parallel>
                </Sequence>

                <Sequence name="SearchCenter">
                <SetControllerSource source="pure_pursuit"/>
                  <GoToAction zone="center"/>
                  <Parallel success_count="1" failure_count="1">
                    <Sequence>
                      <SetControllerSource source="drive_raw"/>
                      <DriveRawAction linear_x="0.0" angular_z="0.02" duration_sec="23.0"/>
                      <AlwaysFailure/>
                    </Sequence>
                    <Sequence>
                      <SetBlackboard output_key="search_zone" value="center"/>
                      <WaitForQRPoseAction timeout_sec="999" qr_pose="{qr_pose}" qr_data="{qr_data}"/>
                    </Sequence>
                  </Parallel>
                </Sequence>
              </Fallback>

            </RetryUntilSuccessful>

            <SetHeightFromZone zone="{search_zone}" fork_height="{fork_height}"/>

            <Fallback name="RunAndCleanup">
              <Sequence name="DockingSequence">
              <SetControllerSource source="visual_servoing"/>
                <RetryUntilSuccessful num_attempts="-1">
                  <Fallback name="VisualServoingWithRecovery">
                    <VisualServoingAction target_area="25000.0"/>
                    <Sequence name="VSBackupRecovery">
                      <DriveRawAction linear_x="-0.02" angular_z="0.0" duration_sec="8.0"/>
                      <DriveRawAction linear_x="0.0"   angular_z="0.0" duration_sec="1.0"/>
                      <AlwaysFailure/>
                    </Sequence>
                  </Fallback>
                </RetryUntilSuccessful>

                <MoveForklift target_height="{fork_height}" timeout_s="15.0" tolerance_mm="3.0"/>

                <SetControllerSource source="drive_raw"/>
                <DriveRawAction linear_x="0.04"  angular_z="0.0" duration_sec="15.0"/>
                <DriveRawAction linear_x="0.0"   angular_z="0.0" duration_sec="3.0"/>

              <MoveForklift target_height="80.0" timeout_s="15.0" tolerance_mm="3.0"/>

                <DriveRawAction linear_x="-0.03" angular_z="0.0" duration_sec="8.0"/>
                <DriveRawAction linear_x="0.0"   angular_z="0.0" duration_sec="2.0"/>
                <DriveRawAction linear_x="0.0"   angular_z="0.06" duration_sec="9.0"/>
              </Sequence>
              <AlwaysSuccess/>
            </Fallback>

            <SetControllerSource source="pure_pursuit"/>
            <!--<SetReverseMode reverse="true"/>-->
            <GoToAction zone="{qr_data}"/>
            <!--<DriveRawAction linear_x="0.0" angular_z="0.05" duration_sec="8.0"/>-->
            <RetryUntilSuccessful num_attempts="2">
              <Fallback>
                <MoveForklift target_height="25.0" timeout_s="15.0" tolerance_mm="3.0"/>
                <Sequence>
                  <MoveForklift target_height="30.0" timeout_s="5.0" tolerance_mm="5.0"/>
                  <AlwaysFailure/>
                </Sequence>
              </Fallback>
            </RetryUntilSuccessful>
            <!--<SetReverseMode reverse="false"/>-->
            <DriveRawAction linear_x="-0.03" angular_z="0.0" duration_sec="8.0"/>
            <GoToAction zone="inspect"/>
          </Sequence>
        </KeepRunningUntilFailure>s
      </Sequence>
    </BehaviorTree>
  </root>