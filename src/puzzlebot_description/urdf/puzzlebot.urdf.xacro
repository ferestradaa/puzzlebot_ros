<?xml version="1.0"?>
<robot name="puzzlebot" xmlns:xacro="http://www.ros.org/wiki/xacro">

 <xacro:include filename="$(find puzzlebot_description)/urdf/parameters.xacro"/>
  <xacro:include filename="$(find puzzlebot_description)/urdf/materials.xacro"/>
  <xacro:include filename="$(find puzzlebot_description)/urdf/macros.xacro"/>

  <!-- Arguments for using multiple robots if necessary -->
  <xacro:arg name="prefix" default=""/>
  <xacro:property name="prefix" value="$(arg prefix)"/>



  <!--
    base_footprint:reference frame fo assuming the robot is at z=0 (floor) -->
  <link name="${prefix}base_footprint"/>
  <joint name="${prefix}base_footprint_to_base_link" type="fixed">
    <parent link="${prefix}base_footprint"/>
    <child  link="${prefix}base_link"/>
    <!-- the chassis lays on the floor considering wheels radius-->
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>



  <link name="${prefix}base_link"/>
  <joint name="${prefix}base_link_to_chassis" type="fixed">
    <parent link="${prefix}base_link"/>
    <child  link="${prefix}chassis_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>




  <link name="${prefix}chassis_link">
    <visual>
      <origin xyz="0.04 0 -0.05" rpy="0 0 0"/>
      <geometry>
   <!-- <mesh filename="../meshes3/puzzlebot_chassis_detailed.obj"/> -->
        <!--<mesh filename="file://${mesh_chassis}"/> -->
        <mesh filename="package://puzzlebot_description/meshes/puzzlebot_chassis_detailed.obj"/>        
       <!-- <mesh filename="../meshes3/puzzlebot_chassis_detailed.obj"/> -->
      </geometry>
      <material name="white"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${chassis_mass}"/>
      <xacro:box_inertia
        m="${chassis_mass}"
        x="${chassis_length}"
        y="${chassis_width}"
        z="${chassis_height}"/>
    </inertial>
  </link>



  <link name="${prefix}caster_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
   <!-- <mesh filename="../meshes3/puzzlebot_caster_wheel.obj"/> -->
        <!--<mesh filename="file://${caster_wheel}"/> -->
        <!--<mesh filename="package://puzzlebot_description/meshes/puzzlebot_wheel.obj"/>-->
        <mesh filename="package://puzzlebot_description/meshes/puzzlebot_caster_wheel.obj"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="${caster_radius}"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${caster_mass}"/>
      <xacro:sphere_inertia m="${caster_mass}" r="${caster_radius}"/>
    </inertial>

  </link>

  <joint name="${prefix}chassis_to_caster" type="fixed">
    <parent link="${prefix}chassis_link"/>
    <child  link="${prefix}caster_wheel_link"/>
    <origin xyz="${caster_x} ${caster_y} ${caster_z}" rpy="0 0 0"/>
  </joint>



  <!-- Left wheel -->
  <link name="${prefix}left_wheel_link">
    <visual>
      <origin xyz="0 0 -0.046" rpy="0 0 0"/>
      <geometry>
   <!-- <mesh filename="../meshes3/puzzlebot_wheel.obj"/> -->
        <!--<mesh filename="file://${mesh_wheel}"/> -->
        <mesh filename="package://puzzlebot_description/meshes/puzzlebot_wheel.obj"/>
      </geometry>
      <material name="orange"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="${PI/2} 0 0"/>
      <geometry>
        <cylinder length="${wheel_thickness}" radius="${wheel_radius}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${wheel_mass}"/>
      <xacro:cylinder_inertia
        m="${wheel_mass}"
        r="${wheel_radius}"
        l="${wheel_thickness}"/>
    </inertial>
  </link>
  <joint name="${prefix}base_to_left_wheel" type="continuous">
    <parent link="${prefix}chassis_link"/>
    <child  link="${prefix}left_wheel_link"/>
    <origin xyz="${wheel_x_offset} ${wheel_separation} 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>



  <!-- RIGHT WHEEL -->
  <link name="${prefix}right_wheel_link">
    <visual>
      <origin xyz="0 0 -0.046" rpy="0 0 ${PI}"/>
      <geometry>
   <!-- <mesh filename="../meshes3/puzzlebot_wheel.obj"/> -->
        <!--<mesh filename="file://${mesh_wheel}"/> -->
        <mesh filename="package://puzzlebot_description/meshes/puzzlebot_wheel.obj"/>
      </geometry> 
      <material name="orange"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="${PI/2} 0 0"/>
      <geometry>
        <cylinder length="${wheel_thickness}" radius="${wheel_radius}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${wheel_mass}"/>

      <xacro:cylinder_inertia
        m="${wheel_mass}"
        r="${wheel_radius}"
        l="${wheel_thickness}"/>
    </inertial>
  </link>
  <joint name="${prefix}base_to_right_wheel" type="continuous">
    <parent link="${prefix}chassis_link"/>
    <child  link="${prefix}right_wheel_link"/>
    <origin xyz="${wheel_x_offset} -${wheel_separation} 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>



  <!-- lidar -->
  <link name="${prefix}laser">
    <collision>
      <origin xyz="${lidar_cx} 0 ${lidar_cz}" rpy="0 0 0"/>
      <geometry>
        <cylinder length="${lidar_length}" radius="${lidar_radius}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="${lidar_cx} 0 ${lidar_cz}" rpy="0 0 0"/>
      <mass value="${lidar_mass}"/>
      <inertia ixx="4.76e-05" ixy="0.0" ixz="0.0" iyy="4.76e-05" iyz="0.0" izz="6.3e-05"/>
    </inertial>
  </link>
  <joint name="${prefix}chassis_to_lidar" type="fixed">
    <parent link="${prefix}chassis_link"/>
    <child  link="${prefix}laser"/>
    <origin xyz="${lidar_x} ${lidar_y} ${lidar_z}" rpy="0 0 ${PI}"/>
  </joint>


  <!-- outer mast: fixed to the chassis -->
  <link name="${prefix}outer_mast_link">
    <visual>
      <origin xyz="${outer_mast_visual_x} 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://puzzlebot_description/meshes/outer_mast.obj"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="${outer_mast_com}" rpy="0 0 0"/>
      <geometry>
        <box size="${outer_mast_box}"/>
      </geometry>
    </collision>
    <inertial>
      <!-- COM at the centroid of the collision box, not at the link frame -->
      <origin xyz="${outer_mast_com}" rpy="0 0 0"/>
      <mass value="${outer_mast_mass}"/>
      <inertia ixx="2.73e-04" ixy="0.0" ixz="0.0" iyy="2.46e-04" iyz="0.0" izz="3.7e-05"/>
    </inertial>
  </link>
  <joint name="${prefix}outer_mast_joint" type="fixed">
    <parent link="${prefix}chassis_link"/>
    <child  link="${prefix}outer_mast_link"/>
    <origin xyz="${outer_mast_x} ${outer_mast_y} ${outer_mast_z}" rpy="0 0 0"/>
  </joint>


  <!-- inner mast: prismatic stage 2, lifts out of the outer mast -->
  <link name="${prefix}inner_mast_link">
    <visual>
      <origin xyz="0 0 ${inner_mast_visual_z}" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://puzzlebot_description/meshes/inner_mast.obj"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="${inner_mast_com}" rpy="0 0 0"/>
      <geometry>
        <box size="${inner_mast_box}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="${inner_mast_com}" rpy="0 0 0"/>
      <mass value="${inner_mast_mass}"/>
      <inertia ixx="1.916e-04" ixy="0.0" ixz="0.0" iyy="1.716e-04" iyz="0.0" izz="2.19e-05"/>
    </inertial>
  </link>
  <joint name="${prefix}inner_mast_joint" type="prismatic">
    <parent link="${prefix}outer_mast_link"/>
    <child  link="${prefix}inner_mast_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="${inner_lower}" upper="${inner_upper}" effort="10" velocity="0.05"/>
    <dynamics damping="2.0" friction="0.5"/>
  </joint>


  <!-- forks: carriage that slides up the inner mast (stage 1) -->
  <link name="${prefix}forks_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://puzzlebot_description/meshes/forks.obj"/>
      </geometry>
      <material name="black"/>
    </visual>
    <!-- carriage backplate -->
    <collision>
      <origin xyz="${back_origin}" rpy="0 0 0"/>
      <geometry>
        <box size="${back_size}"/>
      </geometry>
    </collision>
    <!-- left tine -->
    <collision>
      <origin xyz="${tine_l_origin}" rpy="0 0 0"/>
      <geometry>
        <box size="${tine_size}"/>
      </geometry>
    </collision>
    <!-- right tine -->
    <collision>
      <origin xyz="${tine_r_origin}" rpy="0 0 0"/>
      <geometry>
        <box size="${tine_size}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="${forks_com}" rpy="0 0 0"/>
      <mass value="${forks_mass}"/>
      <inertia ixx="1.672e-04" ixy="1.712e-05" ixz="3.227e-05" iyy="1.378e-04" iyz="-7.54e-06" izz="2.432e-04"/>
    </inertial>
  </link>
  <joint name="${prefix}forks_joint" type="prismatic">
    <parent link="${prefix}inner_mast_link"/>
    <child  link="${prefix}forks_link"/>
    <origin xyz="0 0 ${forks_z}" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="${forks_lower}" upper="${forks_upper}" effort="10" velocity="0.05"/>
    <dynamics damping="2.0" friction="0.5"/>
  </joint>


  <!-- Frame at the front end of the tines. Not in the Isaac URDF (it has no mass or geometry), but
       navigation looks it up (go_to_server, pure_pursuit_fork) so it stays here. -->
  <link name="${prefix}fork_tip_link"/>
  <joint name="${prefix}forks_to_tip" type="fixed">
    <parent link="${prefix}forks_link"/>
    <child  link="${prefix}fork_tip_link"/>
    <origin xyz="${fork_tip_x} 0 ${fork_tip_z}" rpy="0 0 0"/>
  </joint>


  <!-- camera: carried by the forks -->
  <link name="${prefix}camera_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${camera_mass}"/>
      <xacro:box_inertia
        m="${camera_mass}"
        x="${camera_length}"
        y="${camera_width}"
        z="${camera_height}"/>
    </inertial>
  </link>
  <joint name="${prefix}chassis_to_camera" type="fixed">
    <parent link="${prefix}forks_link"/>
    <child  link="${prefix}camera_link"/>
    <origin xyz="${camera_x} ${camera_y} ${camera_z}" rpy="0 0 0"/>
  </joint>


  <!-- optical frame -->
  <link name="${prefix}camera_color_optical_frame">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${optical_mass}"/>
      <inertia ixx="${optical_inertia}" ixy="0.0" ixz="0.0" iyy="${optical_inertia}" iyz="0.0" izz="${optical_inertia}"/>
    </inertial>
  </link>
  <joint name="${prefix}optical_frame" type="fixed">
    <parent link="${prefix}camera_link"/>
    <child  link="${prefix}camera_color_optical_frame"/>
    <origin xyz="0 0 0" rpy="${-PI/2} 0 ${-PI/2}"/>
  </joint>

</robot>
