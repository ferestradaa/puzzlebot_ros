<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">


  <xacro:property name="PI" value="3.14159265358979"/>


  <xacro:property name="chassis_length" value="0.20"/>
  <xacro:property name="chassis_width"  value="0.16"/>
  <xacro:property name="chassis_height" value="0.06"/>
  <xacro:property name="chassis_mass"   value="0.710"/>


  <xacro:property name="wheel_radius"    value="0.05"/>
  <xacro:property name="wheel_thickness" value="0.01"/>
  <xacro:property name="wheel_mass"      value="0.03"/>

  <!-- Distancia desde el centro del chassis al centro de cada rueda en Y -->
  <xacro:property name="wheel_separation" value="0.095"/>
  <!-- Offset en X: las ruedas no están centradas, van ligeramente adelante -->
  <xacro:property name="wheel_x_offset"   value="0.05"/>



  <xacro:property name="caster_radius" value="0.0065"/>
  <xacro:property name="caster_mass"   value="0.012"/>
  <!-- Posicionn relativa al chassis atras y abajo -->
  <xacro:property name="caster_x" value="-0.095"/>
  <xacro:property name="caster_y" value="0.0"/>
  <xacro:property name="caster_z" value="-0.0425"/>


  <xacro:property name="camera_mass"   value="0.007"/>
  <xacro:property name="camera_length" value="0.05"/>
  <xacro:property name="camera_width"  value="0.01"/>
  <xacro:property name="camera_height" value="0.06"/>

  <!-- camera pose in forks_link, so it rides up and down with the carriage -->
  <xacro:property name="camera_x" value="0.015"/>
  <xacro:property name="camera_y" value="0.0"/>
  <xacro:property name="camera_z" value="0.1"/>
  <!-- a link without <inertial> gets 1 kg in PhysX, so even the optical frame carries a token mass -->
  <xacro:property name="optical_mass" value="0.0001"/>
  <xacro:property name="optical_inertia" value="1e-9"/>


  <xacro:property name="lidar_mass"   value="0.1"/>
  <xacro:property name="lidar_x"      value="0.03"/>
  <xacro:property name="lidar_y"      value="0.0"/>
  <xacro:property name="lidar_z"      value="0.13"/>
  <!-- sized from the lidar head in the chassis mesh; expressed in the laser frame, which is yawed 180 deg -->
  <xacro:property name="lidar_radius" value="0.0355"/>
  <xacro:property name="lidar_length" value="0.044"/>
  <xacro:property name="lidar_cx"     value="-0.0095"/>
  <xacro:property name="lidar_cz"     value="-0.014"/>


  <!-- outer mast: fixed to the chassis_link -->
  <xacro:property name="outer_mast_x" value="0.12"/>
  <xacro:property name="outer_mast_y" value="0.0"/>
  <!-- mesh bottom sits 0.8 cm above the chassis mesh bottom (z -0.0491 in the chassis frame) -->
  <xacro:property name="outer_mast_z" value="-0.0418"/>
  <xacro:property name="outer_mast_mass" value="0.1"/>
  <xacro:property name="outer_mast_visual_x" value="0.01"/>
  <xacro:property name="outer_mast_box" value="0.025 0.0621 0.1698"/>
  <xacro:property name="outer_mast_com" value="-0.0032 -0.0003 0.0856"/>

  <!-- inner mast: smaller cross section so it nests inside the outer one -->
  <xacro:property name="inner_mast_mass" value="0.08"/>
  <xacro:property name="inner_mast_visual_z" value="0.023"/>
  <xacro:property name="inner_mast_box" value="0.012 0.0561 0.16"/>
  <xacro:property name="inner_mast_com" value="-0.0078 -0.0005 0.1125"/>
  <!-- inner mesh bottom also rests 0.8 cm above the chassis bottom; limits shifted by the same amount so
       the world-frame travel of the stack is unchanged -->
  <xacro:property name="inner_mast_z" value="-0.0318"/>
  <xacro:property name="inner_lower" value="-0.006"/>
  <xacro:property name="inner_upper" value="0.2836"/>

  <!-- forks (carriage). 0.0736 cancels the outer and inner mast drops so the forks keep their height at rest -->
  <xacro:property name="forks_z" value="0.0736"/>
  <xacro:property name="forks_mass" value="0.15"/>
  <xacro:property name="forks_com" value="0.0178 0.0097 0.0196"/>
  <xacro:property name="forks_lower" value="-0.044"/>
  <xacro:property name="forks_upper" value="0.0664"/>
  <xacro:property name="back_origin"  value="0.0056 0.01255 0.025"/>
  <xacro:property name="back_size"    value="0.0112 0.1087 0.0417"/>
  <xacro:property name="tine_l_origin" value="0.0578 0.0231 0.002"/>
  <xacro:property name="tine_r_origin" value="0.0578 -0.0224 0.002"/>
  <xacro:property name="tine_size"    value="0.1053 0.0184 0.004"/>
  <!-- front end of the tines, used as the pallet-engaging frame -->
  <xacro:property name="fork_tip_x" value="0.1105"/>
  <xacro:property name="fork_tip_z" value="0.002"/>


  <xacro:property name="mesh_chassis"
    value="$(find puzzlebot_description)/meshes/puzzlebot_chassis_detailed.obj"/>
  <xacro:property name="mesh_wheel"
    value="$(find puzzlebot_description)/meshes/puzzlebot_wheel.obj"/>
  <xacro:property name="caster_wheel"
    value="$(find puzzlebot_description)/meshes/puzzlebot_caster_wheel.obj"/>
  <xacro:property name="mesh_forks"
    value="$(find puzzlebot_description)/meshes/forks.obj"/>
  <xacro:property name="mesh_outer_mast"
    value="$(find puzzlebot_description)/meshes/outer_mast.obj"/>
  <xacro:property name="mesh_inner_mast"
    value="$(find puzzlebot_description)/meshes/inner_mast.obj"/>

</robot>