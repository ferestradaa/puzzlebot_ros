# Goal
uint8 goal_type
uint8 NAMED_ZONE = 0
uint8 POSE       = 1

string zone_name
geometry_msgs/PoseStamped target_pose

---
# Result
bool success
uint8 error_code
uint8 OK           = 0
uint8 PLANNER_FAIL = 1
uint8 TIMEOUT      = 2
uint8 ABORTED      = 3

---
# Feedback
float32 distance_remaining
float32 angle_remaining