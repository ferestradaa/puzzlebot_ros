    # Box colliders fitted to the mesh (profile rasterised from the triangles, mm; parent scale = 0.001):
    # 3 hollow stringers (y -3..14), top deck (y 14..17) and the two end bottom boards (y -3..0).
    # Fork openings: 2 x 45 mm wide, 14 mm tall (y 0..14), through the full 100.6 mm depth.
    def Xform "colliders"
    {
        quatf xformOp:orient = (1, 0, 0, 0)
        float3 xformOp:scale = (0.001, 0.001, 0.001)
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        def Cube "stringer_left" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
        )
        {
            double size = 1
            uniform token purpose = "guide"
            bool physics:collisionEnabled = 1
            rel material:binding:physics = </Pallet/PhysicsMaterial> (
                bindMaterialAs = "weakerThanDescendants"
