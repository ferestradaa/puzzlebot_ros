      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.03"/>
      <inertia ixx="1.9000000000000004e-05" ixy="0.0" ixz="0.0" iyy="1.9000000000000004e-05" iyz="0.0" izz="3.7500000000000003e-05"/>
    </inertial>
  </link>
  <joint name="base_to_left_wheel" type="continuous">
    <parent link="chassis_link"/>
    <child link="left_wheel_link"/>
    <origin rpy="0 0 0" xyz="0.05 0.095 0"/>
    <axis xyz="0 1 0"/>
  </joint>
  <!-- RIGHT WHEEL -->
  <link name="right_wheel_link">
    <visual>
      <origin rpy="0 0 3.14159265358979" xyz="0 0 -0.046"/>
      <geometry>
      <mesh filename="../meshes3/puzzlebot_wheel.obj"/>
      </geometry>
      <material name="orange"/>
    </visual>
    <collision>
      <origin rpy="1.570796326794895 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.01" radius="0.05"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.03"/>
      <inertia ixx="1.9000000000000004e-05" ixy="0.0" ixz="0.0" iyy="1.9000000000000004e-05" iyz="0.0" izz="3.7500000000000003e-05"/>
    </inertial>
  </link>
  <joint name="base_to_right_wheel" type="continuous">
    <parent link="chassis_link"/>
    <child link="right_wheel_link"/>
    <origin rpy="0 0 0" xyz="0.05 -0.095 0"/>
    <axis xyz="0 1 0"/>
  </joint>


  <!-- lidar -->
  <link name="laser">
    <!-- sized from the lidar head in the chassis mesh (r 0.0355, z 0.079-0.123 in chassis frame);
         origin is expressed in this link's frame, which is yawed 180 deg -->
    <collision>
      <origin rpy="0 0 0" xyz="-0.0095 0 -0.014"/>
      <geometry>
        <cylinder length="0.044" radius="0.0355"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="-0.0095 0 -0.014"/>
      <mass value="0.1"/>
      <inertia ixx="4.76e-05" ixy="0.0" ixz="0.0" iyy="4.76e-05" iyz="0.0" izz="6.3e-05"/>
    </inertial>
  </link>
  <joint name="chassis_to_lidar" type="fixed">
    <parent link="chassis_link"/>
    <child link="laser"/>
    <origin rpy="0 0 3.14159265358979" xyz="0.03 0.0 0.13"/>
  </joint>
  <!-- outer_mast  -->


    <!-- outer mast: fixed to chassis, box spans z 0.015 to 0.185 in its own frame -->
  <link name="outer_mast_link">
    <visual>
      <origin rpy="0 0 0" xyz="0.01 0.0 0.0"/>
      <geometry>
        <mesh filename="../meshes3/outer_mast.obj"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="-0.0032 -0.0003 0.0856"/>
      <geometry>
        <box size="0.025 0.0621 0.1698"/>
      </geometry>
    </collision>
    <inertial>
      <!-- COM at the centroid of the collision box, not at the link frame -->
      <origin rpy="0 0 0" xyz="-0.0032 -0.0003 0.0856"/>
      <mass value="0.1"/>
      <inertia ixx="2.73e-04" ixy="0.0" ixz="0.0" iyy="2.46e-04" iyz="0.0" izz="3.7e-05"/>
    </inertial>
  </link>
  <joint name="outer_mast_joint" type="fixed">
    <parent link="chassis_link"/>
    <child link="outer_mast_link"/>
    <!-- mesh bottom (z 0.0007 in this frame) sits 0.8 cm above the chassis mesh bottom (z -0.0491 in the chassis frame) -->
    <origin rpy="0 0 0" xyz="0.12 0.0 -0.0418"/>
  </joint>

  <!-- inner mast: smaller cross section so it nests inside the outer mast -->
  <link name="inner_mast_link">
    <visual>
      <origin rpy="0 0 0" xyz="0.0 0.0 0.023"/>
      <geometry>
        <mesh filename="../meshes3/inner_mast.obj"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="-0.0078 -0.0005 0.1125"/>
      <geometry>
        <box size="0.012 0.0561 0.16"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="-0.0078 -0.0005 0.1125"/>
      <mass value="0.08"/>
      <inertia ixx="1.916e-04" ixy="0.0" ixz="0.0" iyy="1.716e-04" iyz="0.0" izz="2.19e-05"/>
    </inertial>
  </link>
  <joint name="inner_mast_joint" type="prismatic">
    <parent link="outer_mast_link"/>
    <child link="inner_mast_link"/>
    <!-- inner mesh bottom (z 0.0325 in its frame) also rests 0.8 cm above the chassis bottom.
         lower/upper are shifted by the same amount so the world-frame travel of the stack is unchanged:
         it can still go down to just above the floor and up to the same height -->
    <origin rpy="0 0 0" xyz="0 0 -0.0318"/>
    <axis xyz="0 0 1"/>
    <limit effort="10" lower="-0.006" upper="0.2836" velocity="0.05"/>
    <dynamics damping="2.0" friction="0.5"/>
  </joint>

  <!-- forks: carried by the inner mast, not by the chassis -->
  <link name="forks_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="../meshes3/forks.obj"/>
      </geometry>
      <material name="black"/>
    </visual>
    <!-- carriage backplate -->
    <collision>
      <origin rpy="0 0 0" xyz="0.0056 0.01255 0.025"/>
      <geometry>
        <box size="0.0112 0.1087 0.0417"/>
      </geometry>
    </collision>
    <!-- left tine -->
    <collision>
      <origin rpy="0 0 0" xyz="0.0578 0.0231 0.002"/>
      <geometry>
        <box size="0.1053 0.0184 0.004"/>
      </geometry>
    </collision>
    <!-- right tine -->
    <collision>
      <origin rpy="0 0 0" xyz="0.0578 -0.0224 0.002"/>
      <geometry>
        <box size="0.1053 0.0184 0.004"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="0.0178 0.0097 0.0196"/>
      <mass value="0.15"/>
      <inertia ixx="1.672e-04" ixy="1.712e-05" ixz="3.227e-05" iyy="1.378e-04" iyz="-7.54e-06" izz="2.432e-04"/>
    </inertial>
  </link>
  <!-- carriage: slides up the inner mast first; once it is at its limit the inner mast starts to extend -->
  <joint name="forks_joint" type="prismatic">
    <parent link="inner_mast_link"/>
    <child link="forks_link"/>
    <!-- 0.0736 cancels the outer (-0.0418) and inner (-0.0318) mast drops so the forks, camera and
         fork tip keep their previous height at rest -->
    <origin rpy="0 0 0" xyz="0 0 0.0736"/>
    <axis xyz="0 0 1"/>
    <!-- 0.0664 keeps the carriage backplate (0.0417 tall) inside the inner mast length (it sits 0.0336
         higher on the mast than before); -0.044 lets the tines reach the floor now that the inner mast
         box hits it below -0.006. Stack total is still [-0.05, 0.35] -->
    <limit effort="10" lower="-0.044" upper="0.0664" velocity="0.05"/>
    <dynamics damping="2.0" friction="0.5"/>
  </joint>



  <!-- camera -->
  <link name="camera_link">
    <!-- without an <inertial> PhysX gives a link a default mass of 1 kg -->
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.007"/>
      <inertia ixx="2.1583333333333336e-06" ixy="0.0" ixz="0.0" iyy="3.5583333333333337e-06" iyz="0.0" izz="1.516666666666667e-06"/>
    </inertial>
  </link>
  <joint name="chassis_to_camera" type="fixed">
    <parent link="forks_link"/>
    <child link="camera_link"/>
    <origin rpy="0 0 0" xyz="0.015 0.0 0.1"/>
  </joint>
  <!-- optical frame -->
  <link name="camera_color_optical_frame">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.0001"/>
      <inertia ixx="1e-9" ixy="0.0" ixz="0.0" iyy="1e-9" iyz="0.0" izz="1e-9"/>
    </inertial>
  </link>
  <joint name="optical_frame" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_color_optical_frame"/>
    <origin rpy="-1.570796326794895 0 -1.570796326794895" xyz="0.0 0 0"/>
  </joint>
</robot>
