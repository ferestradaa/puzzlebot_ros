  </material>
  <material name="blue">
    <color rgba="0.20 0.24 0.29 1.0"/>
  </material>
  <material name="orange">
    <color rgba="1.0 0.1 0.0 1.0"/>
  </material>
  <!--
    base_footprint:reference frame fo assuming the robot is at z=0 (floor) -->
  <link name="base_footprint"/>
  <joint name="base_footprint_to_base_link" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <!-- the chassis lays on the floor considering wheels radius-->
    <origin rpy="0 0 0" xyz="0 0 0.05"/>
  </joint>
  <link name="base_link"/>
  <joint name="base_link_to_chassis" type="fixed">
    <parent link="base_link"/>
    <child link="chassis_link"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
  </joint>
  <link name="chassis_link">
    <visual>
      <origin rpy="0 0 0" xyz="0.04 0 -0.05"/>
      <geometry>
        <mesh filename="../meshes3/puzzlebot_chassis_detailed.obj"/>
      </geometry>
      <material name="white"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.2 0.16 0.06"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.71"/>
      <inertia ixx="0.0017276666666666666" ixy="0.0" ixz="0.0" iyy="0.002579666666666667" iyz="0.0" izz="0.0038813333333333334"/>
    </inertial>
  </link>
  <link name="caster_wheel_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
      <mesh filename="../meshes3/puzzlebot_caster_wheel.obj"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <sphere radius="0.0065"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.012"/>
      <inertia ixx="2.028e-07" ixy="0.0" ixz="0.0" iyy="2.028e-07" iyz="0.0" izz="2.028e-07"/>
    </inertial>
  </link>
  <joint name="chassis_to_caster" type="fixed">
    <parent link="chassis_link"/>
    <child link="caster_wheel_link"/>
    <origin rpy="0 0 0" xyz="-0.095 0.0 -0.0425"/>
  </joint>
  <!-- Left wheel -->
  <link name="left_wheel_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 -0.046"/>
      <geometry>
      <mesh filename="../meshes3/puzzlebot_wheel.obj"/>
      </geometry>
      <material name="orange"/>
    </visual>
    <collision>
      <origin rpy="1.570796326794895 0 0" xyz="0 0 0"/>
      <geometry>
